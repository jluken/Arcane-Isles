        value: 3
        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Hah! A [var=PlayerFormal] and a scholar after my own heart, and an
          asset to the crew. With a few more like you, we''ll soon be off this island
          and headed for home. When the captain returns I''ll be sure to tell him
          of your resourcefulness. '
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
