    - id: 27
      fields:
      - title: Title
        value: 
        type: 0
        typeString: 
      - title: Description
        value: 
        type: 0
        typeString: 
      - title: Actor
        value: 5
        type: 5
        typeString: CustomFieldType_Actor
      - title: Conversant
