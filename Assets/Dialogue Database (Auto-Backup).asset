      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: 'Very well. If you change your mind, my name is Dr Charles Braam.
          Were you able to find any other survivors with hopefully similarly impervious
          constitutions? '
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 6
      isRoot: 0
