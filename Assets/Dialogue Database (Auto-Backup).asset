        type: 5
        typeString: CustomFieldType_Actor
      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: That should do it. Dr Charles Braam at your service. Tell me, are
          there any others with you?
        type: 0
        typeString: 
