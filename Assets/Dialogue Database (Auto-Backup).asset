      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: It's a bunch of superstitious ramblings and a decaying pile of stones.
          We're leaving.
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
