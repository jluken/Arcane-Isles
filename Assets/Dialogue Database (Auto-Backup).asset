      - title: Menu Text
        value: 
        type: 0
        typeString: 
      - title: Dialogue Text
        value: You studied this place?
        type: 0
        typeString: 
      - title: Sequence
        value: 
        type: 0
        typeString: 
      conversationID: 17
      isRoot: 0
      isGroup: 0
      nodeColor: 
